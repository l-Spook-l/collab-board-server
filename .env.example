PROJECT_NAME="your project name"   # Project name
DEBUG=True                              # Debug mode (True for development, False for production)
ALLOWED_ORIGINS=["*"]                   # CORS allowed origins, e.g. ["http://localhost:3000", "https://yourdomain.com"]
LOG_LEVEL=DEBUG           # Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
FRONTEND_URL=

POSTGRES_USER=postgres            # Database user
POSTGRES_PASSWORD=postgres      # Database password
POSTGRES_HOST=db              # e.g. localhost or db (docker service name)
POSTGRES_PORT=5432                      # Database port
POSTGRES_DB=postgres             # Database name

JWT_SECRET_KEY="your-super-puper-secret-key"          # Secret key for JWT signing (keep secure, long random string)
ALGORITHM=HS256                            # JWT algorithm (HS256 for symmetric signing)
ACCESS_TOKEN_EXPIRE_MINUTES=1440           # Access token lifetime in minutes (1440 = 1 day)

AUTH0_DOMAIN=       # Auth0 domain (e.g. dev-xxxxx.us.auth0.com)
AUTH0_AUDIENCE=     # Auth0 API Identifier (audience URL from Auth0 dashboard)
AUTH0_NAMESPACE=    # Namespace for custom JWT claims (must be URL format, ends with /)

STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_PRICE_ID=price_YOUR_PRICE_ID
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET
